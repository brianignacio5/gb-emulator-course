{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "types": ["vitest/globals", "node"],
    "baseUrl": ".",
    "paths": {
      "@emu/*": ["src/*"]
    }
  },
  "include": ["src", "tests", "solutions", "vite.config.ts", "vitest.config.ts"]
}
